#!/bin/bash

set -euo pipefail

readonly PLUGIN_ID="io.github.ilyazar.cliamp"
readonly CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json"

fail() {
  printf 'cliamp-widget: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'USAGE'
Usage: cliamp-widget [show|hide|status]

With no arguments, restore the CLIamp bar widget and make its icon visible.
USAGE
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "required command not found: $1"
}

restore_widget() {
  require_command omarchy-shell
  require_command omarchy

  omarchy-shell shell rescanPlugins >/dev/null ||
    fail "could not ask the running Omarchy shell to rescan plugins"
  omarchy bar put "$PLUGIN_ID" >/dev/null ||
    fail "plugin is not installed or could not be added to the bar"
  omarchy bar set "$PLUGIN_ID" iconVisible true --json >/dev/null ||
    fail "widget was added, but its hidden state could not be cleared"

  printf 'CLIamp widget is on the bar and visible\n'
}

hide_widget() {
  require_command omarchy
  omarchy bar set "$PLUGIN_ID" iconVisible false --json >/dev/null ||
    fail "widget is not on the bar"
  printf 'CLIamp widget icon is hidden; its service remains enabled\n'
}

widget_status() {
  require_command omarchy
  require_command jq

  local catalog plugin enabled entry section visibility
  catalog="$(omarchy plugin list --json)" ||
    fail "could not read the Omarchy plugin catalog"
  plugin="$(
    jq -c --arg id "$PLUGIN_ID" '[.[] | select(.id == $id)][0] // null' \
      <<<"$catalog"
  )"
  [[ $plugin != "null" ]] || fail "plugin is not installed"
  enabled="$(jq -r '.enabled == true' <<<"$plugin")"

  entry="null"
  section="none"
  if [[ -s $CONFIG_FILE ]]; then
    IFS=$'\t' read -r section entry < <(
      jq -rc --arg id "$PLUGIN_ID" '
        ["left", "center", "right"] as $sections
        | first(
            $sections[] as $section
            | (.bar.layout[$section] // [])[]
            | select((if type == "object" then .id else . end) == $id)
            | [
                $section,
                (if type == "object" then . else {id: .} end | tojson)
              ]
          ) // ["none", "null"]
        | @tsv
      ' "$CONFIG_FILE"
    )
  fi

  if [[ $entry == "null" ]]; then
    visibility="not on bar"
  elif [[ $(jq -r \
    'if has("iconVisible") then .iconVisible else true end' \
    <<<"$entry") == "true" ]]; then
    visibility="visible"
  else
    visibility="hidden"
  fi

  printf 'plugin: installed\n'
  printf 'service: %s\n' "$([[ $enabled == true ]] && printf enabled || printf disabled)"
  printf 'bar: %s%s\n' "$visibility" \
    "$([[ $section == none ]] && printf '' || printf ' (%s)' "$section")"
}

command="${1:-show}"
(( $# <= 1 )) || {
  usage >&2
  exit 2
}

case "$command" in
  show) restore_widget ;;
  hide) hide_widget ;;
  status) widget_status ;;
  -h | --help | help) usage ;;
  *)
    usage >&2
    exit 2
    ;;
esac
